<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero banner for the focused title, a tab bar (Home / Movies / Series) and rows of posters.
  Layout is for a 1280x720 UI.
-->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="0x0B0B0FFF" />
    <Poster id="backdrop" translation="[340, 0]" width="940" height="529" loadWidth="940" loadHeight="529" loadDisplayMode="scaleToZoom" />
    <Poster translation="[340, 0]" width="440" height="540" uri="pkg:/images/fade_left.png" />
    <Poster translation="[320, 280]" width="960" height="260" uri="pkg:/images/fade_bottom.png" />
    <Rectangle translation="[0, 528]" width="1280" height="192" color="0x0B0B0FFF" />
    <Poster translation="[0, 0]" width="1280" height="140" uri="pkg:/images/fade_top.png" />

    <Poster translation="[48, 30]" uri="pkg:/images/wordmark.png" width="147" height="34" />
    <Group id="tabs" translation="[232, 26]" />

    <LayoutGroup id="hero" translation="[48, 112]" layoutDirection="vert" itemSpacings="[8, 12]">
      <Label id="heroTitle" width="600" wrap="true" maxLines="2" color="0xF5F5F7FF" />
      <Label id="heroMeta" width="600" color="0xB4B4C2FF" />
      <Label id="heroPlot" width="520" wrap="true" maxLines="3" lineSpacing="3" color="0xD2D2DCFF" />
    </LayoutGroup>

    <Group translation="[0, 372]" clippingRect="[0, 0, 1280, 348]">
      <RowList id="rows"
        translation="[48, 30]"
        itemComponentName="PosterItem"
        numRows="3"
        itemSize="[1232, 236]"
        rowItemSize="[[120, 180]]"
        rowItemSpacing="[[16, 0]]"
        itemSpacing="[0, 8]"
        showRowLabel="[true]"
        rowLabelColor="0xE6E6EEFF"
        rowFocusAnimationStyle="floatingFocus"
        vertFocusAnimationStyle="fixedFocus"
        drawFocusFeedback="false" />
    </Group>

    <Label id="status" translation="[48, 470]" width="1184" horizAlign="center" color="0xB4B4C2FF" />

    <Timer id="heroTimer" duration="0.6" repeat="false" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Progress.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Pills.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>
