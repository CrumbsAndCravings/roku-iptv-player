<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero banner for the focused title, a glass tab bar (Home / Movies / Series / Categories /
  Search) and rows of posters. Layout is for a 1280x720 UI.
-->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="0x151028FF" />
    <!-- Settles from a little bigger as it fades in; grows from its left edge, which the fade covers. -->
    <Poster id="backdrop" translation="[340, 0]" width="940" height="529" loadWidth="940" loadHeight="529" loadDisplayMode="scaleToZoom" scaleRotateCenter="[0, 264]" />
    <!-- The moving banner's other picture (common/Slides.brs). -->
    <Poster id="backdropFront" translation="[340, 0]" width="940" height="529" loadWidth="940" loadHeight="529" loadDisplayMode="scaleToZoom" scaleRotateCenter="[0, 264]" opacity="0" />
    <Poster translation="[340, 0]" width="440" height="540" uri="pkg:/images/fade_left.png" />
    <Poster translation="[320, 280]" width="960" height="260" uri="pkg:/images/fade_bottom.png" />
    <Rectangle translation="[0, 528]" width="1280" height="192" color="0x151028FF" />
    <Poster translation="[0, 0]" width="1280" height="140" uri="pkg:/images/fade_top.png" />

    <!-- Soft lavender and pink glows give the plum background some warmth. -->
    <Poster translation="[-300, -330]" width="820" height="820" uri="pkg:/images/glow.png" blendColor="0xB9A3FFFF" opacity="0.16" />
    <Poster translation="[880, 470]" width="640" height="640" uri="pkg:/images/glow.png" blendColor="0xFF9ECFFF" opacity="0.10" />

    <Poster translation="[48, 27]" uri="pkg:/images/logo.png" width="110" height="40" />
    <Poster translation="[164, 22]" uri="pkg:/images/sparkle.png" width="14" height="14" blendColor="0xFFD98AFF" />

    <!--
      The tab bar: floating glass, as in the web app (tools/make_images.py draws it). A
      glass lens rests on the current tab; with the bar focused it's lit lavender and
      springs from tab to tab, stretching as it goes. The tab names inside the lens are a
      second, dark copy (lensView), clipped to the lens, so the lens shows them dark
      wherever it is. OK swells the bar and lifts the lens (HomeScreen.brs, styleTabs).
      Slots are 112 wide, 4 in from the bar's ends.
    -->
    <Group id="tabBar" translation="[204, 23]" scaleRotateCenter="[284, 24]">
      <Poster translation="[-40, -40]" width="648" height="128" uri="pkg:/images/glass_shadow.png" />
      <Poster width="568" height="48" uri="pkg:/images/glass_bar.png" />
      <Group id="lens" translation="[4, 4]">
        <Group id="lensShape" scaleRotateCenter="[56, 20]">
          <Poster id="lensClear" width="112" height="40" uri="pkg:/images/lens_fill.png" opacity="0.1" />
          <Poster id="lensLit" width="112" height="40" uri="pkg:/images/lens_fill.png" blendColor="0xC9B8FFFF" opacity="0" />
        </Group>
      </Group>
      <Group id="tabLabels" />
      <Group id="lensTop" translation="[4, 4]">
        <Group clippingRect="[0, 0, 112, 40]">
          <Group id="lensView" translation="[-4, -4]" opacity="0" />
        </Group>
        <Group id="lensShine" scaleRotateCenter="[56, 20]">
          <Poster id="lensGlass" width="112" height="40" uri="pkg:/images/lens_glass.png" opacity="0.6" />
          <Poster id="lensRim" width="112" height="40" uri="pkg:/images/lens_rim.png" opacity="0.3" />
        </Group>
      </Group>
    </Group>
    <!-- Takes focus while the tab bar is active; its keys bubble up to this screen. -->
    <Group id="navKeys" />

    <LayoutGroup id="hero" translation="[48, 112]" layoutDirection="vert" itemSpacings="[8, 12]">
      <Label id="heroTitle" width="600" wrap="true" maxLines="2" color="0xF7F3FFFF" />
      <Label id="heroMeta" width="600" color="0xC3B8E6FF" />
      <Label id="heroPlot" width="520" wrap="true" maxLines="3" lineSpacing="3" color="0xDDD4F7FF" />
    </LayoutGroup>

    <Group translation="[0, 372]" clippingRect="[0, 0, 1280, 348]">
      <RowList id="rows"
        translation="[48, 30]"
        itemComponentName="PosterItem"
        numRows="3"
        itemSize="[1232, 218]"
        rowItemSize="[[120, 180]]"
        rowItemSpacing="[[10, 0]]"
        itemSpacing="[0, 8]"
        showRowLabel="[true]"
        rowLabelColor="0xEEE8FFFF"
        rowFocusAnimationStyle="floatingFocus"
        vertFocusAnimationStyle="fixedFocus"
        drawFocusFeedback="false" />
    </Group>

    <Label id="status" translation="[140, 450]" width="1000" horizAlign="center" wrap="true" maxLines="3" lineSpacing="4" color="0xC3B8E6FF" />

    <Timer id="heroTimer" duration="0.6" repeat="false" />
    <Timer id="slideTimer" duration="7" repeat="true" />
    <!-- Starts the library worker for the rows picked for you, once Home and its own rows are up. -->
    <Timer id="picksTimer" duration="6" repeat="false" />

    <Animation id="backdropIn" duration="0.5" easeFunction="outQuad">
      <FloatFieldInterpolator id="backdropFade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdrop.opacity" />
    </Animation>
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Compat.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Progress.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Motion.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Slides.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Taste.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/MyList.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Categories.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>
