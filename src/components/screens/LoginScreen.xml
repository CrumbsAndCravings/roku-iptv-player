    <Poster translation="[212, 74]" uri="pkg:/images/sparkle.png" width="16" height="16" blendColor="0xFFD98AFF" />
    <Poster translation="[1168, 118]" uri="pkg:/images/sparkle.png" width="22" height="22" blendColor="0xF7F3FFFF" opacity="0.8" />
    <Poster translation="[680, 640]" uri="pkg:/images/sparkle.png" width="14" height="14" blendColor="0xC9B8FFFF" opacity="0.8" />
    <Label id="heading" translation="[96, 146]" width="600" color="0xF7F3FFFF" text="Welcome to ARAN+" />
