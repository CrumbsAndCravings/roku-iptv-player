<?xml version="1.0" encoding="utf-8"?>
<component name="LoginScreen" extends="Group">
  <interface>
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="0x151028FF" />
    <Poster translation="[-260, -300]" width="900" height="900" uri="pkg:/images/glow.png" blendColor="0xB9A3FFFF" opacity="0.22" />
    <Poster translation="[760, 330]" width="760" height="760" uri="pkg:/images/glow.png" blendColor="0xFF9ECFFF" opacity="0.14" />
