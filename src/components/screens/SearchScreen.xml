<?xml version="1.0" encoding="utf-8"?>
<!--
  Keyboard on the left, results on the right (a Movies row and a Series row) that
  update as you type. The keyboard is created in code so newer Rokus get the
  DynamicMiniKeyboard (with voice entry) and older ones fall back to MiniKeyboard.
-->
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="0x151028FF" />
    <Poster width="1280" height="140" uri="pkg:/images/fade_top.png" />
    <Poster translation="[-300, -330]" width="820" height="820" uri="pkg:/images/glow.png" blendColor="0xB9A3FFFF" opacity="0.16" />
    <Poster translation="[880, 470]" width="640" height="640" uri="pkg:/images/glow.png" blendColor="0xFF9ECFFF" opacity="0.10" />
    <Poster translation="[164, 22]" uri="pkg:/images/sparkle.png" width="14" height="14" blendColor="0xFFD98AFF" />
    <Poster translation="[48, 27]" uri="pkg:/images/logo.png" width="110" height="40" />
    <Label id="heading" translation="[232, 26]" width="600" height="42" vertAlign="center" color="0xF7F3FFFF" text="Search" />

    <Group id="keyboardHolder" translation="[36, 96]" />
    <!-- Symbols the keyboard lacks; placed under it in code. -->
    <Group id="symbols" />
    <Group id="symbolFocus" />
    <!-- Library loading progress, beside the heading so the symbols have room below the keyboard. -->
    <Label id="status" translation="[372, 26]" width="860" height="42" vertAlign="center" maxLines="1" color="0x8579B0FF" />

    <RowList id="results"
      translation="[480, 96]"
      itemComponentName="PosterItem"
      numRows="2"
      itemSize="[752, 232]"
      rowItemSize="[[120, 180]]"
      rowItemSpacing="[[10, 0]]"
      itemSpacing="[0, 12]"
      showRowLabel="[true]"
      rowLabelColor="0xEEE8FFFF"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="floatingFocus"
      drawFocusFeedback="false" />
    <Label id="message" translation="[480, 150]" width="752" wrap="true" maxLines="3" color="0xC3B8E6FF" />
    <Label id="focusTitle" translation="[480, 626]" width="752" wrap="true" maxLines="2" color="0xF7F3FFFF" />

    <Timer id="debounce" duration="0.35" repeat="false" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
</component>
