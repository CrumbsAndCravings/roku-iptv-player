<?xml version="1.0" encoding="utf-8"?>
<!--
  Movie or series details. Series get a season bar and an episode list below the buttons;
  moving down scrolls the page up to reveal them.
-->
<component name="DetailsScreen" extends="Group">
  <interface>
    <field id="item" type="node" onChange="onItem" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="0x0B0B0FFF" />
    <Poster id="backdrop" translation="[320, 0]" width="960" height="540" loadWidth="960" loadHeight="540" loadDisplayMode="scaleToZoom" />
    <Poster translation="[320, 0]" width="440" height="540" uri="pkg:/images/fade_left.png" />
    <Poster translation="[320, 280]" width="960" height="260" uri="pkg:/images/fade_bottom.png" />
    <Rectangle translation="[0, 538]" width="1280" height="182" color="0x0B0B0FFF" />
    <Rectangle id="dim" width="1280" height="720" color="0x0B0B0FFF" opacity="0" />

    <Group id="body">
      <LayoutGroup translation="[48, 72]" layoutDirection="vert" itemSpacings="[10, 14, 12]">
        <Label id="title" width="640" wrap="true" maxLines="2" color="0xF5F5F7FF" />
        <Label id="meta" width="640" color="0xB4B4C2FF" />
        <Label id="plot" width="580" wrap="true" maxLines="4" lineSpacing="3" color="0xD2D2DCFF" />
        <Label id="credits" width="580" wrap="true" maxLines="2" color="0x8A8A9AFF" />
      </LayoutGroup>
      <Group id="buttons" translation="[48, 404]" />
      <Label id="status" translation="[48, 470]" width="700" color="0xB4B4C2FF" />
      <Label id="compat" translation="[48, 456]" width="1184" color="0xF5B83DFF" />

      <Group id="episodesPanel" translation="[48, 492]" visible="false">
        <Group id="seasons" />
        <MarkupList id="episodes"
          translation="[0, 62]"
          itemComponentName="EpisodeItem"
          itemSize="[1184, 104]"
          itemSpacing="[0, 10]"
          numRows="5"
          vertFocusAnimationStyle="floatingFocus"
          drawFocusFeedback="false" />
      </Group>
    </Group>

    <!-- Takes focus for the buttons and season bar; its keys bubble up to this screen. -->
    <Group id="keys" />

    <Animation id="scroll" duration="0.3" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollBody" key="[0.0, 1.0]" fieldToInterp="body.translation" />
      <FloatFieldInterpolator id="scrollDim" key="[0.0, 1.0]" fieldToInterp="dim.opacity" />
    </Animation>
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Compat.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Progress.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Pills.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
</component>
