<?xml version="1.0" encoding="utf-8"?>
<!--
  A 210x104 category card for the Categories tab: the category's name, and what it
  holds ("Movies · 104"). Grows a little with a lavender ring when focused.
-->
<component name="CategoryTile" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChange" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
    <field id="rowFocusPercent" type="float" onChange="onFocusChange" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocusChange" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>
  <children>
    <Group id="card" scaleRotateCenter="[105, 52]">
      <Poster id="ring" translation="[-4, -4]" width="218" height="112" uri="pkg:/images/ring.9.png" blendColor="0xC9B8FFFF" opacity="0" />
      <Poster id="base" width="210" height="104" uri="pkg:/images/card.9.png" blendColor="0x30275AFF" />
      <Rectangle id="accent" width="4" height="104" color="0xFF9ECFFF" />
      <Label id="name" translation="[16, 12]" width="182" height="56" wrap="true" maxLines="2" vertAlign="top" color="0xF7F3FFFF" />
      <Label id="caption" translation="[16, 74]" width="182" maxLines="1" color="0xC3B8E6FF" />
    </Group>
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/items/CategoryTile.brs" />
</component>
