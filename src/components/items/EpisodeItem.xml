<?xml version="1.0" encoding="utf-8"?>
<!-- One episode in the details screen's MarkupList: still, number and title, runtime, synopsis. -->
<component name="EpisodeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChange" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
    <field id="listHasFocus" type="boolean" onChange="onFocusChange" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>
  <children>
    <Poster id="highlight" width="1184" height="104" uri="pkg:/images/card.9.png" blendColor="0x2C2350FF" opacity="0" />
    <Poster id="ring" translation="[-5, -5]" width="1194" height="114" uri="pkg:/images/ring.9.png" blendColor="0xC9B8FFFF" opacity="0" />
    <Poster translation="[10, 10]" width="150" height="84" uri="pkg:/images/card.9.png" blendColor="0x241C42FF" />
    <Poster id="still" translation="[10, 10]" width="150" height="84" loadWidth="150" loadHeight="84" loadDisplayMode="scaleToZoom" />
    <Poster id="stillCorners" translation="[10, 10]" width="150" height="84" uri="pkg:/images/corners.9.png" blendColor="0x151028FF" />
    <Rectangle id="track" translation="[18, 84]" width="134" height="4" color="0x151028CC" visible="false" />
    <Rectangle id="fill" translation="[18, 84]" width="0" height="4" color="0xFF9ECFFF" visible="false" />
    <Label id="title" translation="[182, 12]" width="840" color="0xF7F3FFFF" />
    <Label id="runtime" translation="[1030, 12]" width="136" horizAlign="right" color="0xA195CCFF" />
    <Label id="plot" translation="[182, 44]" width="980" wrap="true" maxLines="2" color="0xC3B8E6FF" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/items/EpisodeItem.brs" />
</component>
