<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-running search worker. Builds a title index of the whole library in the
  background (a few categories at a time) and answers each `query` with `results`,
  a ContentNode of up to two rows (Movies, Series) tagged with the query in `forQuery`.
  Started once per session and kept in m.global.search.
-->
<component name="SearchTask" extends="Task">
  <interface>
    <field id="query" type="string" alwaysNotify="true" />
    <field id="stop" type="boolean" />
    <field id="results" type="node" />
    <field id="status" type="assocarray" />
    <!-- { kind: "vod" | "series", categoryId } -> `browsed`: that category's titles, newest first -->
    <field id="browse" type="assocarray" alwaysNotify="true" />
    <field id="browsed" type="node" />
    <!-- Set (any value) to get `counts`: titles per category, keyed "vod:123" / "series:45" -->
    <field id="countsRequest" type="boolean" alwaysNotify="true" />
    <field id="counts" type="assocarray" />
    <!-- { history, watching, because, forKey } -> `picks`: Home's rows picked for you (answerPicks) -->
    <field id="picksRequest" type="assocarray" alwaysNotify="true" />
    <field id="picks" type="node" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/Http.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/XtreamParse.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Categories.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Taste.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/SearchIndex.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/SearchTask.brs" />
</component>
