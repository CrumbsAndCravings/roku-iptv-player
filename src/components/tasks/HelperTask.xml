<?xml version="1.0" encoding="utf-8"?>
<!--
  One request to the helper on a computer at home (common/Helper.brs), off the UI thread.
  request { mode: "info" | "lastError" | "stop", url } ->
  result { ok, info (info) | said (lastError) | error, request }
-->
<component name="HelperTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="result" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Tracks.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Helper.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/HelperTask.brs" />
</component>
